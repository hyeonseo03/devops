# ---------------------------------------------------------------
# 학생 과제: 아래 각 줄이 무엇을 하는지 주석으로 설명을 달아보세요.
# ---------------------------------------------------------------

#파이썬 3.12 슬림 버전을 기반 이미지로 선택합니다.
FROM python:3.12-slim

# 컨테이너 내부의 작업 디렉터리를 /app으로 설정합니다.
WORKDIR /app

# 라이브러리 목록 파일을 컨테이너 내부로 복사합니다.
COPY requirements.txt .

# 복사한 목록을 바탕으로 필요한 패키지를 설치합니다.
RUN pip install --no-cache-dir -r requirements.txt

# 나머지 소스 코드 전체를 컨테이너 안으로 복사합니다.
COPY . .

# 보안을 위해 일반 사용자 계정을 생성하고 전환합니다.
RUN useradd -m appuser
USER appuser

# 웹 애플리케이션의 기본 환경 변수(제목, 색상)를 설정합니다.
ENV APP_TITLE="현서 DevOps 방명록" \
    THEME_COLOR="#7C3AED"

# 컨테이너가 사용할 포트를 문서화합니다.
EXPOSE 5000

# 컨테이너가 실행될 때 파이썬 웹서버를 자동으로 구동합니다.
CMD ["python", "app.py"]
